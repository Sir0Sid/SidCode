# Where build.sh puts the VSCodium and vscode checkouts, and the app it builds.
#
# Gigabytes, reproducible from what is committed here, and the difference between a first push of a
# couple of megabytes and one of twenty. `tools/save-source.sh` keeps a separate copy of it for the
# day the source is not there to fetch.
build/

# The archives handed over, which are made from this folder - and the source and server artifacts
# packed beside it. A release is where those belong; git history is not.
*.tar.gz

# Generated by tools/merge-product.mjs from a VSCodium checkout.
branding/product.json

# The SFTP extension's connection file, which holds each host's password in plain text. It belongs
# to whoever is working in a folder, never to the folder's repository - and a `.vscode/` that is
# committed for its other files (extensions, tasks, launch settings) will take this one with it.
# It reached a public repository once, which is what this line is for.
.vscode/sftp.json

# The VSIX files are deliberately *not* ignored. `extensions/sftp-sid-<version>.vsix` and
# `sidcode-defaults-<version>.vsix` are what get built into the editor, they are small, and this
# folder's whole design is that what is built in is recorded rather than downloaded at build time.
