{
  "name": "Sid's Bright Teal",
  "type": "dark",
  "colors": {
    "titleBar.activeBackground": "#005a56",
    "titleBar.activeForeground": "#ffffff",
    "titleBar.inactiveBackground": "#004d49",
    "menubar.selectionBackground": "#007a74",
    "menubar.selectionForeground": "#ffffff",
    "menu.background": "#1a3331",
    "menu.foreground": "#e0f2f1",
    "menu.selectionBackground": "#007a74",
    "menu.selectionForeground": "#ffffff",
    "menu.separatorBackground": "#2a4a47",
    "menu.border": "#00403d",
    "dropdown.background": "#1a3331",
    "dropdown.foreground": "#e0f2f1",
    "dropdown.border": "#00403d",
    "activityBar.background": "#00403d",
    "activityBar.foreground": "#ffffff",
    "activityBar.inactiveForeground": "#a3d1cf",
    "activityBar.activeBorder": "#00ffea",
    "activityBarBadge.background": "#00ffea",
    "activityBarBadge.foreground": "#000000",
    "sideBar.background": "#142625",
    "sideBar.foreground": "#e0f2f1",
    "sideBarTitle.foreground": "#00ffea",
    "sideBarSectionHeader.background": "#1a3331",
    "sideBarSectionHeader.foreground": "#00ffea",
    "editor.background": "#0b1716",
    "lineHighlightBackground": "#162e2c",
    "editorLineNumber.activeForeground": "#00ffea",
    "editorGroupHeader.tabsBackground": "#101f1e",
    "tab.activeBackground": "#1d3d3a",
    "tab.activeForeground": "#00ffea",
    "tab.activeBorder": "#00ffea",
    "tab.inactiveBackground": "#101f1e",
    "tab.inactiveForeground": "#80cbc4",
    "statusBar.background": "#005a56",
    "statusBar.foreground": "#ffffff",
    "list.activeSelectionBackground": "#007a74",
    "list.activeSelectionForeground": "#ffffff",
    "list.hoverBackground": "#1d3d3a"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6fa39f",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#9ef0c0"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#8fd0ff"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.type",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#00ffea"
      }
    },
    {
      "scope": [
        "storage.modifier",
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#a3d1cf"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#6bffe8"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#7fe9ff"
      }
    },
    {
      "scope": [
        "constant.language",
        "support.constant",
        "variable.language"
      ],
      "settings": {
        "foreground": "#b0fff0"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag",
        "entity.other.attribute-name",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#00d5c3"
      }
    },
    {
      "scope": [
        "entity.name.section",
        "entity.name.section.systemd"
      ],
      "settings": {
        "foreground": "#00ffea",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation.definition.section.systemd",
        "punctuation.definition.section"
      ],
      "settings": {
        "foreground": "#00b3a4"
      }
    },
    {
      "scope": [
        "meta.assignment.systemd"
      ],
      "settings": {
        "foreground": "#e0f2f1"
      }
    },
    {
      "scope": [
        "variable.other",
        "variable.other.systemd"
      ],
      "settings": {
        "foreground": "#b0fff0"
      }
    },
    {
      "scope": [
        "punctuation.section.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#00b3a4"
      }
    },
    {
      "scope": [
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#00ffea",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#e0f2f1",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#80cbc4",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.raw",
        "markup.inline.raw",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#9ef0c0"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ffffff",
        "background": "#9f1239"
      }
    }
  ]
}
