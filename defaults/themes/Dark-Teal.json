{
    "name": "Sid's Dark Teal",
    "type": "dark",
    "colors": {
        "editor.background": "#0b1213",
        "sideBar.background": "#090e0f",
        "activityBar.background": "#06090a",
        "activityBar.foreground": "#00a099",
        "activityBar.inactiveForeground": "#416365",
        "activityBar.activeBorder": "#00a099",
        "activityBarBadge.background": "#00a099",
        "activityBarBadge.foreground": "#ffffff",
        "statusBar.background": "#006661",
        "statusBar.foreground": "#ffffff",
        "titleBar.activeBackground": "#090e0f",
        "titleBar.activeForeground": "#ffffff",
        "panel.background": "#090e0f",
        "panel.border": "#004d49",
        "editorGroupHeader.tabsBackground": "#090e0f",
        "tab.activeBackground": "#0b1213",
        "tab.activeForeground": "#00c4bc",
        "tab.activeBorder": "#00a099",
        "tab.inactiveBackground": "#090e0f",
        "tab.inactiveForeground": "#618b8d",
        "list.activeSelectionBackground": "#003d3a",
        "list.activeSelectionForeground": "#00c4bc",
        "list.hoverBackground": "#0c181a",
        "lineHighlightBackground": "#0e1a1b",
        "editorLineNumber.activeForeground": "#00a099"
    },

    // ── NOT PART OF SIMON'S FILE ────────────────────────────────────
    // His colour set names the workbench surfaces and nothing else. A
    // theme with no token colours leaves every language rendered flat -
    // one colour of text, no syntax - so this block was written to go
    // with it. Everything here is built from his own teals: the bright
    // #00c4bc for keywords and headings, the darker #00a099 for tags,
    // the pale greens and blues for strings and numbers. Identifiers
    // he did not name are left at the theme's own text colour.
    // Delete this whole block and his theme is exactly as he wrote it.
    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "foreground": "#5f8385", "fontStyle": "italic" }
        },
        {
            "scope": ["string", "punctuation.definition.string", "string.quoted"],
            "settings": { "foreground": "#9fd6b8" }
        },
        {
            "scope": ["constant.numeric", "constant.character.escape", "string.regexp"],
            "settings": { "foreground": "#7fb8d8" }
        },
        {
            "scope": ["keyword", "storage", "keyword.control", "storage.type", "keyword.operator.new"],
            "settings": { "foreground": "#00c4bc" }
        },
        {
            "scope": ["storage.modifier", "keyword.operator", "punctuation.separator", "punctuation.terminator"],
            "settings": { "foreground": "#7d9a9c" }
        },
        {
            "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"],
            "settings": { "foreground": "#6ad3c8" }
        },
        {
            "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.name.namespace"],
            "settings": { "foreground": "#7fd8e0" }
        },
        {
            "scope": ["constant.language", "support.constant", "variable.language"],
            "settings": { "foreground": "#8fd0c0" }
        },
        {
            "scope": ["entity.name.tag", "meta.tag", "entity.other.attribute-name", "punctuation.definition.tag"],
            "settings": { "foreground": "#00a099" }
        },
        {
            "scope": ["punctuation.section.embedded", "meta.embedded"],
            "settings": { "foreground": "#009b93" }
        },
        {
            "scope": ["markup.heading", "markup.heading entity.name"],
            "settings": { "foreground": "#00c4bc", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.bold"],
            "settings": { "foreground": "#c6d4d5", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.italic"],
            "settings": { "foreground": "#a8bcbd", "fontStyle": "italic" }
        },
        {
            "scope": ["markup.raw", "markup.inline.raw", "string.other.link"],
            "settings": { "foreground": "#9fd6b8" }
        },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#ffffff", "background": "#9f1239" }
        }
    ]
}
