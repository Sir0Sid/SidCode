{
    "name": "My Workspace",
    "defaultProfile": "example-sftp",
    "profiles": {
        "example-sftp": {
            "host": "your-server.example.com",
            "protocol": "sftp",
            "port": 22,
            "username": "your-username",
            "password": "your-password",
            "remotePath": "/path/on/server",
            "uploadOnSave": true,
            "downloadOnOpen": false
        },
        "example-ftp": {
            "host": "your-ftp-host.example.com",
            "protocol": "ftp",
            "port": 21,
            "username": "your-ftp-username",
            "password": "your-password",
            "remotePath": "/",
            "uploadOnSave": true,
            "downloadOnOpen": false
        }
    },
    "watcher": {
        "files": "dist/*.{js,css}",
        "autoUpload": false,
        "autoDelete": false
    }
}
